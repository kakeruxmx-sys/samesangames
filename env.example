# PROPNIGHT 2 server settings (all optional; defaults shown). Copy to .env or set in your process manager.
# The server does not read .env files itself - export these variables (systemd EnvironmentFile=, docker --env-file, etc.).

# Listen port / interface
PORT=8080
HOST=0.0.0.0

# Where profiles.json (guest profiles) and reports.jsonl (player reports) are stored. MUST be on persistent storage.
DATA_DIR=./data

# Built client directory (default: ./dist/client next to the server)
# STATIC_DIR=./dist/client

# Behind nginx/Caddy/Cloudflare: trust X-Forwarded-For for per-IP limits (set to 1 ONLY when a proxy you control sets it)
TRUST_PROXY=0

# Extra browser Origins allowed to open the WebSocket (comma separated). Same-origin is always allowed.
# Needed only if the client page is served from a different host than the game server.
ALLOWED_ORIGINS=

# Abuse limits
MAX_CONN_PER_IP=8
MAX_NEW_PROFILES_PER_HOUR=30

# Optional: serve https/wss directly instead of using a TLS reverse proxy
# TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem

# ---- TEST ONLY (never set in production) ----
# PN_TEST_SPEED=3             # run the simulation N times faster (automated tests)
# PN_TEST_MATCH_SECONDS=25    # shorten the 15-minute match (results-screen test)
